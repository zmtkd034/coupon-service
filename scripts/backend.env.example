# sudo mkdir -p /etc/coupon && sudo cp backend.env.example /etc/coupon/backend.env 후 값 수정
# 평문 암호는 쓰지 않는다: DB 암호는 SSM Parameter Store SecureString 에서 조회
AWS_REGION=ap-northeast-2
DB_HOST=<rds-endpoint>
DB_PORT=5432
DB_NAME=coupon
DB_USER=coupon
DB_PASSWORD_SSM_PARAM=/coupon/db/password
DB_SSLMODE=require
# 프로세스당 DB 연결 상한. db.t4g.micro 는 max_connections 79 -> 서버 2대 x 워커 2개 x 10 = 40
DB_POOL_MAX=10

REDIS_HOST=<elasticache-endpoint>
REDIS_PORT=6379
REDIS_TLS=true
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3
